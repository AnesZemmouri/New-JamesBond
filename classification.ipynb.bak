    "        \"  2. pictures/tom-holland/*.jpg (or an initials folder listed in actors.csv)\\n\"\n",
    "        \"  3. python FaceModel/build_embeddings.py\\n\"\n",
    "        \"  4. restart the kernel and run this notebook top to bottom.\"\n",
    "    )\n",
    "else:\n",
    "    result = predict_fit(actor_id=HOLDOUT_ACTOR)\n",
    "    print(f\"held-out actor : {HOLDOUT_ACTOR}  (isBond = 0, never trained on)\")\n",
    "    print(f\"fit_probability: {result['fit_probability']}\")\n",
    "    print(f\"n_images       : {result['n_images']}\")\n",
    "    print(f\"nearest_bond   : {result['nearest_bond']}\")\n",
    "    print(\"\\ncosine to each Bond:\")\n",
    "    for b, v in result[\"cosine_to_bonds\"].items():\n",
    "        print(f\"  {b:<18} {v:+.4f}\")\n",
    "    print(\"\\ntop PCA contributions:\")\n",
    "    for c in result[\"top_components\"]:\n",
    "        print(f\"  {c['component']:<6} {c['contribution']:+.4f}\")"
   ]
