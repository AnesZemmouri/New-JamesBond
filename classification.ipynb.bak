   "source": [
    "X = np.load(DATASET / \"embeddings.npy\").astype(np.float64)\n",
    "meta = pd.read_csv(DATASET / \"embeddings.csv\", usecols=[\"actor_id\", \"image_id\"])\n",
    "images = pd.read_csv(DATASET / \"images.csv\")\n",
    "\n",
    "# Actor metadata may be split: actors.csv holds the six Bonds, candidates.csv the\n",
    "# negatives being added. build_embeddings.py reads both, so read both here too.\n",
    "META_COLS = [\"actor_id\", \"isBond\", \"heightCm\"]\n",
    "frames = []\n",
    "for name in (\"actors.csv\", \"candidates.csv\", \"candidate.csv\"):\n",
    "    path = DATASET / name\n",
    "    if not path.exists() or path.stat().st_size == 0:  # skip empty placeholder\n",
    "        continue\n",
    "    frame = pd.read_csv(path)\n",
    "    for col in META_COLS:\n",
    "        if col not in frame.columns:\n",
    "            frame[col] = np.nan          # absent column -> NaN, handled by the guard\n",
    "    frames.append(frame[META_COLS])\n",
    "    print(f\"  {name}: {len(frames[-1])} actor row(s)\")\n",
    "\n",
    "if not frames:\n",
    "    raise FileNotFoundError(\"no actors.csv / candidates.csv under \" + str(DATASET))\n",
    "actors = pd.concat(frames, ignore_index=True).drop_duplicates(\"actor_id\")\n",
    "\n",
    "df = (\n",
    "    meta\n",
    "    .merge(images[[\"image_id\", \"status\", \"qc_flag\", \"path\"]], on=\"image_id\", how=\"left\")\n",
    "    .merge(actors, on=\"actor_id\", how=\"left\")\n",
    ")\n",
    "df[\"qc_flag\"] = df[\"qc_flag\"].fillna(\"\")\n",
    "\n",
    "print(f\"X {X.shape} | rows {len(df)} | actors {df['actor_id'].nunique()}\")\n",
    "df[[\"actor_id\", \"image_id\", \"status\", \"qc_flag\", \"isBond\", \"heightCm\"]].head(8)"
   ]
  },
