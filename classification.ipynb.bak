   "metadata": {},
   "source": [
    "## 10. Inference — `predict_fit`\n",
    "\n",
    "Feed an `actor_id` from the dataset or paths to face photos. Returns:\n",
    "\n",
    "- `fit_probability` — the model's P(Bond-like), averaged over the images given\n",
    "- `nearest_bond` — highest cosine similarity to a Bond's mean embedding, plus the\n",
    "  score for all six\n",
    "- `top_components` — contribution of each PCA direction to the logit\n",
    "  (`coef_i * value_i`); the largest-magnitude ones are what moved the decision\n",
    "- `top_embedding_dims` — the same contribution mapped back to the 512 embedding\n",
    "  dimensions\n",
    "\n",
    "**PC indices and embedding dims carry no semantic label.** \"PC3\" is not \"jaw\n",
    "width\"; the ordering is arbitrary and not comparable between retrains."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "f44c041b",
   "metadata": {},
   "outputs": [],
   "source": [
    "def embed_image(path: Path) -> np.ndarray:\n",
    "    # Same model as build_embeddings.py so the embedding matches the training set.\n",
    "    import cv2\n",
    "    from insightface.app import FaceAnalysis\n",
    "\n",
    "    global _APP\n",
    "    if \"_APP\" not in globals():\n",
    "        _APP = FaceAnalysis(name=\"buffalo_l\")\n",
    "        _APP.prepare(ctx_id=0, det_size=(640, 640))\n",
    "\n",
    "    img = cv2.imread(str(path))\n",
    "    if img is None:\n",
    "        raise FileNotFoundError(path)\n",
    "    faces = _APP.get(img)\n",
    "    if not faces:\n",
    "        raise ValueError(f\"no face detected in {path}\")\n",
    "    face = max(faces, key=lambda f: (f.bbox[2] - f.bbox[0]) * (f.bbox[3] - f.bbox[1]))\n",
    "    return face.normed_embedding.astype(np.float64)\n",
    "\n",
    "\n",
    "def predict_fit(actor_id=None, image_paths=None, top_n=5):\n",
    "    # Score one actor (from the dataset) or a set of photo paths.\n",
    "    if (actor_id is None) == (image_paths is None):\n",
    "        raise ValueError(\"pass exactly one of actor_id / image_paths\")\n",
    "\n",
    "    if actor_id is not None:\n",
    "        known = sorted(set(groups_all))\n",
    "        if actor_id not in known:\n",
    "            raise KeyError(f\"{actor_id!r} not in embeddings. known: {known}\")\n",
    "        Z = X_all[groups_all == actor_id]\n",
    "    else:\n",
    "        Z = np.vstack([embed_image(to_path(p)) for p in image_paths])\n",
    "\n",
    "    scale, pca, clf = (model.named_steps[s] for s in (\"scale\", \"pca\", \"clf\"))\n",
    "    Zs = scale.transform(Z)\n",
    "    T = pca.transform(Zs)\n",
    "\n",
    "    # -- nearest Bond by cosine similarity to the Bond mean embedding --------\n",
    "    bond_ids = sorted(set(g_tr[y_tr == 1]))\n",
    "    sims = {}\n",
    "    for b in bond_ids:\n",
    "        c = X_tr[g_tr == b].mean(axis=0)\n",
    "        c /= np.linalg.norm(c)\n",
    "        sims[b] = float((Z @ c).mean())\n",
    "\n",
    "    # -- contributions ------------------------------------------------------\n",
    "    contrib_pc = clf.coef_[0] * T.mean(axis=0)              # per PCA direction\n",
    "    w_eff = pca.pca_.components_.T @ clf.coef_[0]           # back to 512 dims\n",
    "    contrib_dim = w_eff * Zs.mean(axis=0)\n",
    "\n",
    "    top_pc = np.argsort(-np.abs(contrib_pc))[:top_n]\n",
    "    top_dim = np.argsort(-np.abs(contrib_dim))[:top_n]\n",
    "\n",
    "    return {\n",
    "        \"fit_probability\": round(float(model.predict_proba(Z)[:, 1].mean()), 4),\n",
    "        \"n_images\": int(len(Z)),\n",
    "        \"nearest_bond\": max(sims, key=sims.get),\n",
    "        \"cosine_to_bonds\": {b: round(v, 4) for b, v in\n",
    "                            sorted(sims.items(), key=lambda kv: -kv[1])},\n",
    "        \"top_components\": [{\"component\": f\"PC{i + 1}\",\n",
    "                            \"contribution\": round(float(contrib_pc[i]), 4)} for i in top_pc],\n",
    "        \"top_embedding_dims\": [{\"dim\": int(i),\n",
    "                                \"contribution\": round(float(contrib_dim[i]), 4)} for i in top_dim],\n",
    "    }"
   ]
  },
