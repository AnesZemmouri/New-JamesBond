    "def to_path(raw) -> Path:\n",
    "    # Normalise the separator, then resolve relative to the project root.\n",
    "    p = Path(str(raw).replace(\"\\\\\", \"/\"))\n",
    "    return p if p.is_absolute() else ROOT / p\n",
    "\n",
    "\n",
    "print(\"raw     :\", df.loc[keep, \"path\"].iloc[0])\n",
    "print(\"as Path :\", to_path(df.loc[keep, \"path\"].iloc[0]))\n",
    "print(\"exists  :\", to_path(df.loc[keep, \"path\"].iloc[0]).exists())"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "20c0d3fb",
   "metadata": {},
   "source": [
    "## 5. Evaluation harness\n",
    "\n",
    "`LeaveOneGroupOut` holds out one **actor** per fold, so no photo of the test\n",
    "person was ever seen. Because a fold's test set is a single actor — either all\n",
    "positive or all negative — a per-fold AUC is undefined. The metric is therefore\n",
    "computed once over the **pooled out-of-fold scores**: every image is scored by a\n",
    "model that never saw its actor.\n",
    "\n",
    "Also defined here: the per-Bond **rank**, i.e. where a held-out Bond's mean score\n",
    "falls among all out-of-fold negative scores."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "39a6d96f",
   "metadata": {},
   "outputs": [],
   "source": [
    "class ClampedPCA(BaseEstimator, TransformerMixin):\n",
    "    # PCA, but n_components is clamped to what this fold's data can support.\n",
    "    def __init__(self, n_components=5):\n",
    "        self.n_components = n_components\n",
    "\n",
    "    def fit(self, X, y=None):\n",
    "        k = max(1, min(self.n_components, X.shape[0] - 1, X.shape[1]))\n",
    "        self.pca_ = PCA(n_components=k, random_state=RANDOM_STATE).fit(X)\n",
    "        return self\n",
    "\n",
    "    def transform(self, X):\n",
    "        return self.pca_.transform(X)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "66ee497a",
   "metadata": {},
   "outputs": [],
   "source": [
    "def group_oof_scores(estimator, X, y, groups):\n",
    "    # Out-of-fold P(positive) for every row; each fold hides a whole actor.\n",
    "    scores = np.full(len(y), np.nan)\n",
    "    for tr, te in LeaveOneGroupOut().split(X, y, groups):\n",
    "        model = clone(estimator).fit(X[tr], y[tr])\n",
    "        scores[te] = model.predict_proba(X[te])[:, 1]\n",
    "    assert not np.isnan(scores).any(), \"a row was never scored\"\n",
    "    return scores"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "753e22b0",
   "metadata": {},
   "outputs": [],
   "source": [
    "def score_summary(scores, y):\n",
    "    return {\n",
    "        \"roc_auc\": round(roc_auc_score(y, scores), 3),\n",
    "        \"average_precision\": round(average_precision_score(y, scores), 3),\n",
    "        \"n_positive\": int(y.sum()),\n",
    "        \"n_negative\": int((y == 0).sum()),\n",
    "    }\n",
    "\n",
    "\n",
    "def bond_ranks(scores, y, groups):\n",
    "    # Where each Bond's mean score falls among the negatives' out-of-fold scores.\n",
    "    neg = scores[y == 0]\n",
    "    rows = []\n",
    "    for actor in sorted(set(groups[y == 1])):\n",
    "        s = float(scores[groups == actor].mean())\n",
    "        above = int((neg > s).sum())\n",
    "        rows.append({\n",
    "            \"actor_id\": actor,\n",
    "            \"mean_score\": round(s, 4),\n",
    "            \"negatives_above\": above,\n",
    "            \"rank\": f\"{above + 1}/{len(neg)}\",\n",
    "            \"separation\": round(float((neg < s).mean()), 3),\n",
    "        })\n",
    "    return pd.DataFrame(rows).sort_values(\"mean_score\", ascending=False).reset_index(drop=True)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c3e67e6d",
   "metadata": {},
   "source": [
    "## 6. Baseline — cosine similarity to the Bond centroid\n",
    "\n",
    "No training: each fold averages the *training* Bonds into one centroid and scores\n",
    "every image by cosine similarity to it. The centroid is rebuilt per fold, so the\n",
    "held-out Bond is never in it.\n",
    "\n",
    "If logistic regression does not clearly beat this, the extra capacity is buying\n",
    "nothing — which, at n≈6 positives, is a live possibility."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "5b41bd15",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Bond-centroid cosine baseline\n",
      "{'roc_auc': 0.796, 'average_precision': 0.928, 'n_positive': 29, 'n_negative': 11}\n"
     ]
    }
   ],
   "source": [
    "def centroid_oof_scores(X, y, groups):\n",
    "    scores = np.full(len(y), np.nan)\n",
    "    for tr, te in LeaveOneGroupOut().split(X, y, groups):\n",
    "        pos = X[tr][y[tr] == 1]\n",
    "        c = pos.mean(axis=0)\n",
    "        c /= np.linalg.norm(c)\n",
    "        scores[te] = X[te] @ c\n",
    "    return scores\n",
    "\n",
    "\n",
    "base_scores = centroid_oof_scores(X_tr, y_tr, g_tr)\n",
    "print(\"Bond-centroid cosine baseline\")\n",
    "print(score_summary(base_scores, y_tr))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "d2b3bd0e",
   "metadata": {},
   "source": [
    "## 7. Logistic regression\n",
    "\n",
    "`StandardScaler -> PCA(k) -> LogisticRegression(C, class_weight=\"balanced\")`.\n",
    "\n",
    "`class_weight=\"balanced\"` reweights for the positive/negative imbalance, so the\n",
    "score is not just a copy of the prior. `k` and `C` are swept under the *same*\n",
    "group CV used for reporting — the grid below is a diagnostic, not a tuned result\n",
    "picked on the test set (there is no separate test set; see caveats)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "9a690bc8",
   "metadata": {},
   "outputs": [],
   "source": [
    "def build_logreg(k=5, C=1.0):\n",
    "    return Pipeline([\n",
    "        (\"scale\", StandardScaler()),\n",
    "        (\"pca\", ClampedPCA(k)),\n",
    "        (\"clf\", LogisticRegression(\n",
    "            C=C, max_iter=5000, class_weight=\"balanced\", random_state=RANDOM_STATE,\n",
    "        )),\n",
    "    ])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "c914638e",
   "metadata": {},
   "outputs": [
