  {
   "cell_type": "markdown",
   "id": "9ef21dbd",
   "metadata": {},
   "source": [
    "## 8. Actor-level tabular features\n",
    "\n",
    "Everything so far scores *images*. Collapse to **one row per actor** — mean face\n",
    "embedding (through the fold's PCA) and `heightCm` — and ask whether the tabular\n",
    "view carries the same signal.\n",
    "\n",
    "Three variants: `height only`, `face only`, `face + height`. Preprocessing is\n",
    "fitted on training actors only, inside each fold. With ~6 positives at actor\n",
    "level, AUC here is a coarse ranking diagnostic, not an estimate."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "c87022f9",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "actor-level, leave-one-actor-out, n=17 actors\n"
     ]
    },
    {
     "data": {
      "text/html": [
       "<div>\n",
       "<style scoped>\n",
       "    .dataframe tbody tr th:only-of-type {\n",
       "        vertical-align: middle;\n",
       "    }\n",
       "\n",
       "    .dataframe tbody tr th {\n",
       "        vertical-align: top;\n",
       "    }\n",
       "\n",
       "    .dataframe thead th {\n",
       "        text-align: right;\n",
       "    }\n",
       "</style>\n",
       "<table border=\"1\" class=\"dataframe\">\n",
       "  <thead>\n",
       "    <tr style=\"text-align: right;\">\n",
       "      <th></th>\n",
       "      <th>variant</th>\n",
       "      <th>n_features</th>\n",
       "      <th>roc_auc</th>\n",
       "      <th>avg_precision</th>\n",
       "    </tr>\n",
       "  </thead>\n",
       "  <tbody>\n",
       "    <tr>\n",
       "      <th>0</th>\n",
       "      <td>height only</td>\n",
       "      <td>1</td>\n",
       "      <td>0.530</td>\n",
       "      <td>0.458</td>\n",
       "    </tr>\n",
       "    <tr>\n",
       "      <th>1</th>\n",
       "      <td>face only</td>\n",
       "      <td>3</td>\n",
       "      <td>0.879</td>\n",
       "      <td>0.830</td>\n",
       "    </tr>\n",
       "    <tr>\n",
       "      <th>2</th>\n",
       "      <td>face + height</td>\n",
       "      <td>4</td>\n",
       "      <td>0.591</td>\n",
       "      <td>0.539</td>\n",
       "    </tr>\n",
       "  </tbody>\n",
       "</table>\n",
       "</div>"
      ],
      "text/plain": [
       "         variant  n_features  roc_auc  avg_precision\n",
       "0    height only           1    0.530          0.458\n",
       "1      face only           3    0.879          0.830\n",
       "2  face + height           4    0.591          0.539"
      ]
     },
     "execution_count": 15,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "actor_height = df.drop_duplicates(\"actor_id\").set_index(\"actor_id\")[\"heightCm\"].to_dict()\n",
    "\n",
    "\n",
    "def actor_level_oof(use_face=True, use_height=True, k=5, C=0.3):\n",
    "    acts = np.array(sorted(set(g_tr)))\n",
    "    y_act = np.array([int(y_tr[g_tr == a][0]) for a in acts])\n",
    "    h_act = np.array([actor_height.get(a, np.nan) for a in acts], dtype=float)\n",
    "    scores = np.full(len(acts), np.nan)\n",
    "    probe = np.zeros((len(acts), 1))\n",
    "\n",
    "    for tr, te in LeaveOneGroupOut().split(probe, y_act, acts):\n",
    "        feats = []\n",
    "        if use_face:\n",
    "            in_tr = np.isin(g_tr, acts[tr])\n",
    "            sc = StandardScaler().fit(X_tr[in_tr])\n",
    "            pca = ClampedPCA(k).fit(sc.transform(X_tr[in_tr]))\n",
    "            Z = pca.transform(sc.transform(X_tr))\n",
    "            feats.append(np.vstack([Z[g_tr == a].mean(axis=0) for a in acts]))\n",
    "        if use_height:\n",
    "            mu, sd = np.nanmean(h_act[tr]), np.nanstd(h_act[tr])\n",
    "            sd = sd if sd > 0 else 1.0\n",
    "            feats.append(np.nan_to_num((h_act - mu) / sd).reshape(-1, 1))\n",
    "\n",
    "        F = np.hstack(feats)\n",
    "        clf = LogisticRegression(C=C, max_iter=5000, class_weight=\"balanced\",\n",
    "                                 random_state=RANDOM_STATE).fit(F[tr], y_act[tr])\n",
    "        scores[te] = clf.predict_proba(F[te])[:, 1]\n",
    "\n",
    "    return scores, y_act, acts\n",
    "\n",
    "\n",
    "rows = []\n",
    "for name, (face, height) in {\n",
    "    \"height only\": (False, True),\n",
    "    \"face only\": (True, False),\n",
    "    \"face + height\": (True, True),\n",
    "}.items():\n",
    "    s, y_act, acts = actor_level_oof(use_face=face, use_height=height, k=K_BEST)\n",
    "    rows.append({\"variant\": name, \"n_features\": int(face) * K_BEST + int(height),\n",
    "                 \"roc_auc\": round(roc_auc_score(y_act, s), 3),\n",
    "                 \"avg_precision\": round(average_precision_score(y_act, s), 3)})\n",
    "\n",
    "print(f\"actor-level, leave-one-actor-out, n={len(acts)} actors\")\n",
    "pd.DataFrame(rows)"
   ]
  },
