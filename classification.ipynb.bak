    "# Which actors does the face+height variant rank highest? Sanity, not science.\n",
    "s_fh, y_act, acts = actor_level_oof(use_face=True, use_height=True, k=K_BEST)\n",
    "order = np.argsort(-s_fh)\n",
    "pd.DataFrame({\n",
    "    \"actor_id\": acts[order],\n",
    "    \"isBond\": y_act[order],\n",
    "    \"score\": np.round(s_fh[order], 4),\n",
    "}).reset_index(drop=True)"
   ]
